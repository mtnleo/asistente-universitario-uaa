# Copy to .env and edit locally. Never commit a real key or send it in chat.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Confirm the API project itself is Free tier with NO billing attached.
# A Google One/student subscription does not establish API billing status.
# This flag is YOUR confirmation, not a programmatic spending guarantee.
FREE_TIER_CONFIRMED=false

# Only reviewed, non-personal/non-confidential document snippets may be sent.
# Free Gemini inputs/outputs may be used by Google for product improvement.
# Questions must not include personal/confidential information either.
ALLOW_DOCUMENT_SNIPPETS=false

# Optional local chat actions: run configurar_n8n.py for a separate ignored .env.n8n.
# Process environment also accepts N8N_WEBHOOK_URL and N8N_WEBHOOK_KEY.
# Never paste the Header Auth key into chat.
